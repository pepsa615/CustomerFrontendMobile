{
  "name": "mobile",
  "version": "1.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "expo": "~58.0.25",
    "expo-camera": "^58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-picker": "^58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "^58.0.3",
    "expo-location": "^58.0.22",
    "expo-network": "~58.0.5",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.8",
    "jest-expo": "^58.0.15",
    "openapi-typescript": "^7.13.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "jest --runInBand",
    "contract:generate": "openapi-typescript ../backend/openapi/v1.yaml -o src/api/generated/schema.ts",
    "export": "expo export --platform all --output-dir dist",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm run doctor",
    "format": "prettier --write \"src/**/*.tsx\""
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist"
    ]
  }
}
