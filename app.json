{
  "expo": {
    "name": "PEPSA Customer",
    "slug": "pepsa-customer",
    "description": "Book and track deliveries, manage your wallet, pay bills and run your business securely with PEPSA.",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "fallbackToCacheTimeout": 0, "checkAutomatically": "ON_LOAD" },
    "orientation": "portrait",
    "icon": "./assets/images/pepsa-app-icon.png",
    "scheme": "pepsa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/pepsa-app-icon.png",
      "bundleIdentifier": "com.pepsasolution.pepsacustomer",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow PEPSA to unlock your saved session with Face ID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/pepsa-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.pepsasolution.pepsacustomer"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PEPSA to take the identity selfie you choose to submit."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PEPSA to select the identity selfie you choose to submit."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PEPSA to verify your location when you choose to unlock payments."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PEPSA to unlock your saved session with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/pepsa-app-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/pepsa-app-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "41a16ac0-bbdc-449c-ac75-de295781a92f"
      }
    },
    "owner": "pepsa-solution"
  }
}
